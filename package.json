{
  "name": "serverpatterns-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "ServerPatterns — framework de patterns serveur pour Next.js App Router",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "rimraf": "^5.0.7",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "license": "MIT"
}
